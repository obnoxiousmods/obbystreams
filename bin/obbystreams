#!/usr/bin/env python3
"""obbystreams - resilient stream transcoder to DASH and HLS."""

import argparse
import contextlib
import glob
import json
import os
import random
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import threading
import time
import tty
from collections import deque
from dataclasses import dataclass, field

DEFAULT_STREAM_DIR = "/var/www/live.obnoxious.lol/stream"
DEFAULT_FFMPEG_LOG_DIR = "ffmpegLogs"
APP_NAME = "obbystreams"
USER_AGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
SPINNER = ["|", "/", "-", "\\"]


def want_color(args=None):
    if args and getattr(args, "no_color", False):
        return False
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()


def ansi(text, code, args=None):
    if not want_color(args):
        return text
    return f"\033[{code}m{text}\033[0m"


def load_source_headers(path):
    if not path:
        return {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            payload = json.load(f)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"{APP_NAME}: could not load source config {path}: {exc}", file=sys.stderr)
        return {}
    headers_by_url = {}
    for source in payload.get("sources", []) if isinstance(payload, dict) else []:
        if not isinstance(source, dict):
            continue
        url = str(source.get("url") or "").strip()
        raw_headers = source.get("headers") or {}
        if not url or not isinstance(raw_headers, dict):
            continue
        headers = {}
        for key, value in raw_headers.items():
            name = str(key or "").strip()
            if not name or any(ch in name for ch in "\r\n:"):
                continue
            headers[name] = str(value or "").strip()
        if headers:
            headers_by_url[url] = headers
    return headers_by_url


def header_value(headers, name, fallback=None):
    lowered = name.lower()
    for key, value in headers.items():
        if key.lower() == lowered:
            return value
    return fallback


def ffmpeg_extra_headers(headers):
    return "".join(
        f"{name}: {value}\r\n"
        for name, value in headers.items()
        if name.lower() not in {"user-agent"}
    )


def icon(text, args=None):
    return ansi(text, "38;5;45;1", args)


def label(text, args=None):
    return ansi(text, "38;5;111;1", args)


def ok(text, args=None):
    return ansi(text, "38;5;82;1", args)


def warn(text, args=None):
    return ansi(text, "38;5;214;1", args)


def bad(text, args=None):
    return ansi(text, "38;5;203;1", args)


def visible_len(text):
    return len(ANSI_RE.sub("", str(text)))


def fit(text, width):
    text = str(text)
    if width <= 0:
        return ""
    clean = ANSI_RE.sub("", text)
    if len(clean) <= width:
        return text
    if width <= 1:
        return "…"
    return clean[: width - 1] + "…"


def term_width():
    return max(36, shutil.get_terminal_size((100, 24)).columns)


def term_height():
    return max(12, shutil.get_terminal_size((100, 24)).lines)


def panel_width():
    return max(36, min(term_width(), 96))


def progress_bar(ratio, width, args=None):
    width = max(3, width)
    ratio = max(0.0, min(1.0, ratio))
    fill = int(width * ratio)
    bar = "━" * fill + "─" * (width - fill)
    return ansi(bar, "38;5;45", args)


def with_lock(state):
    return state.get("lock") or threading.Lock()


def add_event(state, text, level="info"):
    with with_lock(state):
        state["events"].append((time.time(), level, text))


def emit(state, args, text, level="info"):
    if state.get("live_ui"):
        add_event(state, text, level)
    else:
        prefix = {"info": icon(APP_NAME, args), "ok": ok(APP_NAME, args), "warn": warn(APP_NAME, args), "bad": bad(APP_NAME, args)}.get(level, icon(APP_NAME, args))
        print(f"{prefix} {text}", flush=True)


def render_kv(key, value, width, args=None):
    left = f"  {label(key, args)}"
    gap = " " * max(1, 14 - visible_len(key))
    return fit(left + gap + str(value), width)


@dataclass
class EncoderProfile:
    key: str
    title: str
    codec: str
    score: int
    device: str | None = None
    global_args: list[str] = field(default_factory=list)
    video_args: list[str] = field(default_factory=list)
    reason: str = ""


@dataclass
class StreamHealth:
    index: int
    url: str
    attempts: int = 0
    failures: int = 0
    quick_failures: int = 0
    inconclusive_exits: int = 0
    confirmed_failures: int = 0
    successes: int = 0
    total_runtime: float = 0.0
    assessment_runtime: float = 0.0
    assessment_started_at: float = 0.0
    best_runtime: float = 0.0
    last_runtime: float = 0.0
    last_failure_at: float = 0.0
    last_started_at: float = 0.0
    backoff_until: float = 0.0
    consecutive_failures: int = 0
    consecutive_bad_samples: int = 0
    last_error: str = ""
    last_score: float = 0.0
    last_decision: str = "new"
    score_history: deque = field(default_factory=lambda: deque(maxlen=16))
    tried_this_round: bool = False
    failed_this_round: bool = False
    # Consecutive rc==0 exits on THIS link with no successful long run between
    # them. A clean exit is not evidence the link is bad, so it must not rotate
    # on the first one -- see the escalation ladder.
    clean_exits: int = 0

    @property
    def average_runtime(self):
        if not self.attempts:
            return 0.0
        return self.total_runtime / self.attempts

    def record_start(self):
        self.attempts += 1
        self.last_started_at = time.monotonic()
        if not self.assessment_started_at:
            self.assessment_started_at = self.last_started_at
        self.tried_this_round = True

    def reset_assessment_window(self):
        self.assessment_runtime = 0.0
        self.assessment_started_at = 0.0
        self.consecutive_bad_samples = 0
        self.quick_failures = 0

    def record_exit(self, elapsed, args, failed=True, error_summary="", progress=None, hls=None):
        progress = progress or {}
        hls = hls or {}
        if failed:
            self.failures += 1
        else:
            self.consecutive_failures = 0
        self.last_runtime = elapsed
        self.total_runtime += elapsed
        self.assessment_runtime += elapsed
        self.best_runtime = max(self.best_runtime, elapsed)
        now = time.monotonic()
        if failed:
            self.last_failure_at = now
        if failed and elapsed < args.quick_fail:
            self.quick_failures += 1
        elif not failed:
            self.quick_failures = 0

        score, evidence, reasons = score_stream_evidence(self, args, failed, error_summary, progress, hls)
        self.last_score = score
        if failed and self.assessment_runtime < args.min_assessment_seconds:
            decision = "assessing"
            self.inconclusive_exits += 1
        elif score <= args.failure_score_threshold:
            self.consecutive_bad_samples += 1
            if self.consecutive_bad_samples >= args.confirmed_failure_samples:
                decision = "failed"
                self.confirmed_failures += 1
                self.consecutive_failures += 1
                self.failed_this_round = True
            else:
                decision = "degraded"
        elif score >= args.success_score_threshold:
            decision = "healthy"
            self.successes += 1
            self.consecutive_bad_samples = 0
            self.failed_this_round = False
            self.reset_assessment_window()
        else:
            decision = "degraded" if failed else "ended"
            if score > args.failure_score_threshold / 2:
                self.consecutive_bad_samples = 0
        if decision != "failed" and not failed:
            self.consecutive_failures = 0
        self.last_decision = decision
        self.score_history.append({
            "at": now,
            "score": score,
            "decision": decision,
            "assessment_runtime": self.assessment_runtime,
            "elapsed": elapsed,
            "failed": failed,
            "reasons": reasons,
        })
        return {"decision": decision, "score": score, "evidence": evidence, "reasons": reasons}

    def score(self, now, current_index, explore_bias=20.0):
        if self.backoff_until > now:
            return -1_000_000.0 - (self.backoff_until - now)
        freshness_penalty = max(0.0, 12.0 - (now - self.last_failure_at)) if self.last_failure_at else 0.0
        current_penalty = 8.0 if self.index == current_index else 0.0
        quick_penalty = min(90.0, self.quick_failures * 10.0 + self.confirmed_failures * 24.0)
        explore_bonus = explore_bias if self.attempts == 0 else 0.0
        success_bonus = self.successes * 120.0
        return self.best_runtime * 2.5 + self.average_runtime * 1.5 + self.last_score + success_bonus + explore_bonus - quick_penalty - freshness_penalty - current_penalty


def number_or_zero(value):
    try:
        return float(str(value).strip())
    except (TypeError, ValueError):
        return 0.0


def progress_seconds(value):
    text = str(value or "").strip()
    if not text or text == "N/A":
        return 0.0
    if text.isdigit():
        return float(text) / 1_000_000.0
    parts = text.split(":")
    try:
        if len(parts) == 3:
            return float(parts[0]) * 3600 + float(parts[1]) * 60 + float(parts[2])
    except ValueError:
        return 0.0
    return number_or_zero(text)


def safe_file_size(path):
    try:
        return os.path.getsize(path)
    except OSError:
        return 0


def hls_probe(output_dir, run_id=None):
    """Sample the encoder's output for the health scorer.

    run_id scopes the segment glob to one run. Without it the glob also matched
    the *previous* run's files, which prune_foreign_runs deliberately keeps for
    LEGACY_SEGMENT_GRACE_SECONDS so in-flight players are not 404'd. A brand-new
    run therefore inherited ~125 points of positive evidence (segment_count,
    bytes, last_segment_size) from output it had not produced, and the playlists
    it reads are overwritten by the incoming run so playlist_age looked fresh
    regardless. Net effect: a dead relaunch could not be detected for 180s.
    """
    playlist = os.path.join(output_dir, "ufc.m3u8")
    dash_manifest = os.path.join(output_dir, "ufc.mpd")
    media_playlists = sorted(glob.glob(os.path.join(output_dir, "media_*.m3u8")))
    prefix = f"ufc_r{run_id}_" if run_id else "ufc"
    segments = sorted(
        glob.glob(os.path.join(output_dir, f"{prefix}*.ts"))
        + glob.glob(os.path.join(output_dir, f"{prefix}*.m4s"))
        + glob.glob(os.path.join(output_dir, f"{prefix}*.mp4"))
    )
    segment_names = []
    media_sequence = None
    target_duration = None
    if os.path.exists(playlist):
        try:
            with open(playlist, encoding="utf-8", errors="replace") as f:
                for raw in f:
                    line = raw.strip()
                    if line.startswith("#EXT-X-MEDIA-SEQUENCE:"):
                        media_sequence = line.split(":", 1)[1]
                    elif line.startswith("#EXT-X-TARGETDURATION:"):
                        target_duration = line.split(":", 1)[1]
                    elif line and not line.startswith("#") and not line.endswith(".m3u8"):
                        segment_names.append(line)
        except OSError:
            segment_names = []
    if not segment_names:
        for media_playlist in media_playlists:
            try:
                with open(media_playlist, encoding="utf-8", errors="replace") as f:
                    for raw in f:
                        line = raw.strip()
                        if line.startswith("#EXT-X-MEDIA-SEQUENCE:"):
                            media_sequence = line.split(":", 1)[1]
                        elif line.startswith("#EXT-X-TARGETDURATION:"):
                            target_duration = line.split(":", 1)[1]
                        elif line and not line.startswith("#") and not line.endswith(".m3u8"):
                            segment_names.append(line)
            except OSError:
                continue
    playlist_mtime = os.path.getmtime(playlist) if os.path.exists(playlist) else None
    dash_mtime = os.path.getmtime(dash_manifest) if os.path.exists(dash_manifest) else None
    last_segment = os.path.join(output_dir, segment_names[-1]) if segment_names else None
    return {
        "playlist_exists": os.path.exists(playlist),
        "dash_manifest_exists": os.path.exists(dash_manifest),
        "playlist_ready": bool(segment_names),
        "playlist_age": max(0.0, time.time() - playlist_mtime) if playlist_mtime else None,
        "dash_manifest_age": max(0.0, time.time() - dash_mtime) if dash_mtime else None,
        "playlist_modified_at": playlist_mtime,
        "dash_manifest_modified_at": dash_mtime,
        "segment_count": len(segments),
        "bytes": sum(safe_file_size(path) for path in segments),
        "media_sequence": media_sequence,
        "target_duration": target_duration,
        "last_segment": segment_names[-1] if segment_names else None,
        "last_segment_size": safe_file_size(last_segment) if last_segment else 0,
    }


def score_stream_evidence(stream, args, failed, error_summary, progress, hls):
    score = 0.0
    reasons = []
    assessment_runtime = stream.assessment_runtime
    ramp = max(0.15, min(2.5, assessment_runtime / max(args.failure_ramp_seconds, 1.0)))
    if assessment_runtime < args.min_assessment_seconds:
        ramp *= 0.35

    frame_count = number_or_zero(progress.get("frame"))
    out_seconds = progress_seconds(progress.get("out_time") or progress.get("out_time_ms"))
    speed = str(progress.get("speed", "")).strip()
    speed_value = number_or_zero(speed.rstrip("x")) if speed else 0.0
    progress_seen = frame_count > 0 or out_seconds > 0 or speed_value > 0

    if progress_seen:
        score += 95
    if frame_count > 30:
        score += 45
    if out_seconds >= 5:
        score += 50
    if speed_value > 0:
        score += 25

    if hls.get("playlist_exists"):
        score += 20
    if hls.get("playlist_ready"):
        score += 70
    else:
        score -= min(180, (45 + assessment_runtime * 1.8) * ramp)
        reasons.append("playlist not ready")

    playlist_age = hls.get("playlist_age")
    stale_after = max(args.hls_time * 3, args.timeout, 15)
    if playlist_age is not None and playlist_age <= stale_after:
        score += 85
    elif playlist_age is not None:
        score -= min(220, (60 + max(0.0, playlist_age - stale_after) * 5) * ramp)
        reasons.append(f"playlist stale {playlist_age:.1f}s")

    if hls.get("segment_count", 0) > 0:
        score += 45
    if hls.get("bytes", 0) > 0:
        score += 50
    if hls.get("last_segment_size", 0) > 0:
        score += 30
    if assessment_runtime >= args.min_assessment_seconds:
        score += 45
    if stream.best_runtime >= args.min_assessment_seconds:
        score += min(180, stream.best_runtime * 5)

    lowered_error = (error_summary or "").lower()
    if failed:
        score -= min(160, (25 + stream.quick_failures * 12 + stream.failures * 4) * ramp)
        if assessment_runtime < args.min_assessment_seconds:
            reasons.append(f"still assessing ({assessment_runtime:.1f}/{args.min_assessment_seconds:.1f}s)")
    else:
        score += 55
    if lowered_error:
        score -= min(180, (30 + len(lowered_error.split("|")) * 12) * ramp)
        reasons.append("ffmpeg reported errors")
    else:
        score += 20
    if any(token in lowered_error for token in ("403", "404", "invalid data", "not found")):
        score -= min(150, 60 * ramp)
        reasons.append("hard upstream error")
    if any(token in lowered_error for token in ("429", "too many requests", "rate limit")):
        score -= min(220, 120 * ramp)
        reasons.append("rate limited")
    if failed and not progress_seen and not hls.get("playlist_ready") and assessment_runtime >= args.min_assessment_seconds:
        score -= min(220, (80 + assessment_runtime * 2) * ramp)
        reasons.append("no ffmpeg or HLS progress")

    evidence = {
        "assessment_runtime": round(assessment_runtime, 2),
        "progress_seen": progress_seen,
        "frame": frame_count,
        "out_seconds": round(out_seconds, 2),
        "speed": speed,
        "playlist_ready": bool(hls.get("playlist_ready")),
        "playlist_age": playlist_age,
        "segment_count": hls.get("segment_count", 0),
        "bytes": hls.get("bytes", 0),
        "ramp": round(ramp, 3),
        "reasons": reasons,
    }
    return score, evidence, reasons


def short_url(url, width=88):
    if len(url) <= width:
        return url
    return url[: max(0, width - 3)] + "..."


def find_running_instances():
    my_pid = os.getpid()
    try:
        result = subprocess.run(
            ["pgrep", "-a", "-f", r"/usr/bin/obbystreams|/opt/obbystreams/bin/obbystreams|/usr/bin/ufc|ufc_tool.py|streamUFC"],
            capture_output=True,
            text=True,
        )
        procs = []
        for line in result.stdout.strip().splitlines():
            parts = line.split(None, 1)
            if not parts:
                continue
            try:
                pid = int(parts[0])
            except ValueError:
                continue
            cmd = parts[1] if len(parts) > 1 else ""
            if pid == my_pid or "pgrep" in cmd or "grep" in cmd:
                continue
            base = os.path.basename(cmd.split()[0]) if cmd.split() else ""
            if base in {"bwrap", "zsh", "bash", "sh", "timeout"}:
                continue
            cmd_parts = cmd.split()
            if (
                cmd.startswith("/usr/bin/obbystreams")
                or "/usr/bin/obbystreams" in cmd_parts
                or "/home/joey/obbystreams/bin/obbystreams" in cmd_parts
                or cmd.startswith("/usr/bin/ufc")
                or "/usr/bin/ufc" in cmd_parts
                or "/home/joey/ufc_tool.py" in cmd_parts
                or "streamUFC" in cmd
            ):
                procs.append((pid, cmd))
        return procs
    except Exception:
        return []


def kill_instances(procs):
    for pid, _ in procs:
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGTERM)
    time.sleep(1)
    for pid, _ in procs:
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGKILL)


def run_token():
    """Short, sortable token namespacing one ffmpeg run's segments on disk."""
    return f"{int(time.time()):x}"


# Deliberately not tied to run_token()'s current hex format: a token format change
# must not silently turn pruning into a no-op and leak every run's segments to disk.
_RUN_FILE_RE = re.compile(r"^ufc_r([0-9a-z]+)_")


LEGACY_SEGMENT_GRACE_SECONDS = 180.0

# A run at least this long proves the link works, so a clean upstream close after
# it resets the clean-exit retry budget. It must stay well above
# --min-assessment-seconds, or a link that EOFs every ~20s would refill its budget
# on every attempt and never rotate.
CLEAN_EXIT_RESET_SECONDS = 120.0


def prune_foreign_runs(stream_dir, keep_tokens, legacy_grace=LEGACY_SEGMENT_GRACE_SECONDS):
    """Delete segments belonging to runs other than keep_tokens; return the count.

    Relaunching ffmpeg used to wipe the whole output directory first, which meant
    every restart pulled the init segments and the entire DVR window out from
    under connected players — a 2s process blip became a wall of 404s and a
    forced re-attach for everyone. Namespacing each run's files instead lets the
    previous run's segments stay readable while the new run spins up, so anything
    mid-fetch still resolves. The manifests are deliberately left alone: they are
    overwritten by the incoming run, and until they are, players keep serving
    themselves from segments that still exist.
    """
    removed = 0
    cutoff = time.time() - legacy_grace
    for pattern in ("ufc_r*", "ufc_chunk_*", "ufc_init_*"):
        for path in glob.glob(os.path.join(stream_dir, pattern)):
            match = _RUN_FILE_RE.match(os.path.basename(path))
            if match and match.group(1) in keep_tokens:
                continue
            with contextlib.suppress(OSError):
                # Age gate applies to every foreign file, not just the
                # un-namespaced ones. A supervisor restart (the common path —
                # source refresh, watchdog) starts a fresh process that knows
                # nothing of the previous run's token, so without this it would
                # delete the outgoing run's segments the instant it came up and
                # 404 every viewer mid-handover, which is the whole failure this
                # was meant to remove.
                if os.path.getmtime(path) < cutoff:
                    os.remove(path)
                    removed += 1
    return removed


def ensure_output_dir(path):
    os.makedirs(path, exist_ok=True)
    probe = os.path.join(path, ".ufc-write-test")
    try:
        with open(probe, "w", encoding="utf-8") as f:
            f.write("ok\n")
        os.remove(probe)
    except OSError as exc:
        raise SystemExit(
            f"ufc cannot write to {path}: {exc}\n"
            "Fix the directory owner/group/ACL once; runtime should not need sudo."
        ) from exc


def ensure_ffmpeg_log_dir(path):
    path = os.path.abspath(os.path.expanduser(path or DEFAULT_FFMPEG_LOG_DIR))
    os.makedirs(path, exist_ok=True)
    probe = os.path.join(path, ".obbystreams-log-write-test")
    try:
        with open(probe, "w", encoding="utf-8") as f:
            f.write("ok\n")
        os.remove(probe)
    except OSError as exc:
        raise SystemExit(f"{APP_NAME} cannot write ffmpeg logs to {path}: {exc}") from exc
    return path


def log_timestamp():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def filename_timestamp():
    return time.strftime("%Y%m%d-%H%M%S")


def write_process_log(log_file, lock, kind, text):
    if not log_file:
        return
    with lock:
        log_file.write(f"{log_timestamp()} [{kind}] {text}\n")
        log_file.flush()


def open_ffmpeg_process_log(args, stream, cmd, encoder, proc):
    filename = f"{filename_timestamp()}-pid{proc.pid}-link{stream.index + 1}-attempt{stream.attempts}.log"
    path = os.path.join(args.ffmpeg_log_dir, filename)
    log_file = open(path, "a", encoding="utf-8", buffering=1)
    lock = threading.Lock()
    metadata = {
        "app": APP_NAME,
        "pid": proc.pid,
        "link_index": stream.index + 1,
        "attempt": stream.attempts,
        "url": stream.url,
        "encoder": encoder.key,
        "encoder_codec": encoder.codec,
        "output_dir": args.output_dir,
        "started_at": log_timestamp(),
        "command": cmd,
    }
    log_file.write("# obbystreams ffmpeg process log\n")
    log_file.write(json.dumps(metadata, ensure_ascii=True, sort_keys=True) + "\n")
    log_file.flush()
    return path, log_file, lock


def ffmpeg_encoders():
    try:
        result = subprocess.run(["ffmpeg", "-hide_banner", "-encoders"], capture_output=True, text=True, timeout=8)
        return result.stdout + result.stderr
    except Exception:
        return ""


def readable(path):
    return path and os.path.exists(path) and os.access(path, os.R_OK | os.W_OK)


def render_nodes():
    return [p for p in sorted(glob.glob("/dev/dri/renderD*")) if readable(p)]


def render_vendor(path):
    name = os.path.basename(path)
    sys_path = f"/sys/class/drm/{name}/device/vendor"
    try:
        with open(sys_path, encoding="utf-8") as f:
            return f.read().strip().lower()
    except OSError:
        return ""


def preferred_render_node(vendors):
    nodes = render_nodes()
    for vendor in vendors:
        for node in nodes:
            if render_vendor(node) == vendor:
                return node
    return nodes[0] if nodes else None


def has_nvidia_device():
    return readable("/dev/nvidiactl") and any(readable(p) for p in glob.glob("/dev/nvidia[0-9]*"))


def encoder_available(encoders, codec):
    return codec in encoders


def discover_encoders():
    encoders = ffmpeg_encoders()
    profiles = []

    if encoder_available(encoders, "h264_nvenc") and has_nvidia_device():
        profiles.append(EncoderProfile(
            key="nvenc",
            title="NVIDIA GPU transcode",
            codec="h264_nvenc",
            score=400,
            video_args=["-c:v", "h264_nvenc", "-preset", "p4", "-tune", "ll", "-rc", "vbr"],
        ))

    intel_node = preferred_render_node(["0x8086"])
    if encoder_available(encoders, "h264_qsv") and intel_node:
        profiles.append(EncoderProfile(
            key="qsv",
            title="Intel GPU transcode",
            codec="h264_qsv",
            score=360,
            device=intel_node,
            global_args=["-init_hw_device", f"qsv=hw:{intel_node}", "-filter_hw_device", "hw"],
            video_args=["-vf", "format=nv12,hwupload=extra_hw_frames=64", "-c:v", "h264_qsv", "-preset", "veryfast"],
        ))

    amd_node = preferred_render_node(["0x1002"])
    if encoder_available(encoders, "h264_amf") and amd_node:
        profiles.append(EncoderProfile(
            key="amf",
            title="AMD GPU transcode",
            codec="h264_amf",
            score=340,
            device=amd_node,
            video_args=["-c:v", "h264_amf", "-quality", "speed"],
        ))

    vaapi_node = preferred_render_node(["0x8086", "0x1002"])
    if encoder_available(encoders, "h264_vaapi") and vaapi_node:
        profiles.append(EncoderProfile(
            key="vaapi",
            title="VAAPI GPU transcode",
            codec="h264_vaapi",
            score=300,
            device=vaapi_node,
            global_args=["-vaapi_device", vaapi_node],
            video_args=["-vf", "format=nv12,hwupload", "-c:v", "h264_vaapi"],
        ))

    profiles.append(EncoderProfile(
        key="cpu",
        title="CPU transcode",
        codec="libx264",
        score=0,
        reason="no accessible GPU encoder/device found",
    ))
    return profiles


def choose_encoder(args):
    profiles = discover_encoders()
    by_key = {p.key: p for p in profiles}
    aliases = {
        "auto": None,
        "gpu": None,
        "gpu-only": "gpu-only",
        "gpu-trans": None,
        "nv": "nvenc",
        "nvidia": "nvenc",
        "nvenc": "nvenc",
        "nv-gpu-trans": "nvenc",
        "intel": "qsv",
        "qsv": "qsv",
        "intel-gpu-trans": "qsv",
        "amd": "amf",
        "amf": "amf",
        "amd-gpu-trans": "amf",
        "vaapi": "vaapi",
        "cpu": "cpu",
    }
    wanted = aliases[args.encoder]

    if wanted == "gpu-only":
        gpu_profiles = [p for p in profiles if p.key != "cpu"]
        if not gpu_profiles:
            raise SystemExit("obbystreams: --encoder gpu-only requested, but no accessible GPU encoder/device is available.")
        return max(gpu_profiles, key=lambda p: p.score), profiles

    if wanted:
        if wanted in by_key:
            return by_key[wanted], profiles
        if args.encoder != "cpu":
            print(warn(f"ufc: requested {args.encoder} is not available to this user; falling back to CPU.", args))
        return by_key["cpu"], profiles

    return max(profiles, key=lambda p: p.score), profiles


def build_ffmpeg_cmd(args, url, encoder, run_id="0"):
    cmd = ["ffmpeg", "-hide_banner", "-nostdin", "-y"]
    network_input = url.startswith(("http://", "https://", "rtmp://", "rtmps://"))
    source_headers = getattr(args, "source_headers", {}).get(url, {})

    if not args.verbose:
        cmd += ["-loglevel", "warning"]
    cmd += ["-stats_period", "1", "-progress", "pipe:1"]

    cmd += encoder.global_args
    if network_input:
        extra_headers = ffmpeg_extra_headers(source_headers)
        cmd += [
            "-user_agent", header_value(source_headers, "User-Agent", USER_AGENT),
            "-timeout", str(args.timeout * 1_000_000),
            "-rw_timeout", str(args.timeout * 1_000_000),
        ]
        if extra_headers:
            cmd += ["-headers", extra_headers]

    fflags = "+genpts+discardcorrupt"
    cmd += [
        "-fflags", fflags,
        "-err_detect", "ignore_err",
        "-analyzeduration", str(args.analyzeduration),
        "-probesize", str(args.probesize),
        "-thread_queue_size", str(args.thread_queue_size),
    ]

    if args.reconnect and network_input:
        cmd += [
            "-reconnect", "1",
            "-reconnect_at_eof", "1",
            "-reconnect_streamed", "1",
            "-reconnect_on_network_error", "1",
            "-reconnect_delay_max", str(args.reconnect_delay),
        ]

    # Input pacing. Two failure modes bracket this setting, and both were observed:
    #
    #   bare -re (== -readrate 1 with the default 1.05x catchup): every network
    #   hiccup becomes standing latency the catchup rate is too slow to drain, so
    #   delay COMPOUNDS across a run (measured 15.4s accumulated in 5.5 minutes).
    #
    #   no pacing at all: ffmpeg drains the source's connect-time backlog as fast
    #   as it arrives (measured 1.82x for the first seconds), which pushes the
    #   media clock permanently AHEAD of availabilityStartTime — the manifest then
    #   advertises segments ~6s in the future and every DASH player waits out that
    #   gap as pure added latency.
    #
    # -readrate 1 keeps the media clock on wall clock; a bounded initial burst
    # still fills the pipeline at startup; and a catchup well above 1.05 lets real
    # lag actually drain instead of accumulating.
    if network_input and args.readrate > 0:
        cmd += [
            "-readrate", str(args.readrate),
            "-readrate_initial_burst", str(args.readrate_initial_burst),
            "-readrate_catchup", str(args.readrate_catchup),
        ]

    cmd += ["-i", url]

    video_codec = "h264_nvenc" if encoder.key == "nvenc" else "libx264"
    if encoder.key not in ("cpu", "nvenc"):
        print(warn(f"{APP_NAME}: ABR DASH/HLS output supports CPU/NVENC cleanly; using CPU encode instead of {encoder.key}.", args))

    cmd += [
        "-filter_complex",
        "[0:v]fps=60000/1001,split=2[v720in][v1080in];"
        "[v720in]scale=w=1280:h=720:force_original_aspect_ratio=decrease:force_divisible_by=2,format=yuv420p[v720];"
        "[v1080in]scale=w=1920:h=1080:force_original_aspect_ratio=decrease:force_divisible_by=2,format=yuv420p[v1080]",
        "-map", "[v720]",
        "-map", "[v1080]",
        "-map", "0:a:0?",
        "-c:v:0", video_codec,
        "-c:v:1", video_codec,
    ]

    if video_codec == "libx264":
        cmd += ["-preset:v:0", args.preset, "-preset:v:1", args.preset, "-tune:v:0", "zerolatency", "-tune:v:1", "zerolatency"]
    else:
        cmd += ["-preset:v:0", "p4", "-preset:v:1", "p4", "-tune:v:0", "ll", "-tune:v:1", "ll", "-rc:v:0", "vbr", "-rc:v:1", "vbr"]

    cmd += [
        "-b:v:0", args.video_bitrate_720,
        "-maxrate:v:0", args.maxrate_720,
        "-bufsize:v:0", args.bufsize_720,
        "-b:v:1", args.video_bitrate_1080,
        "-maxrate:v:1", args.maxrate_1080,
        "-bufsize:v:1", args.bufsize_1080,
        "-g:v:0", str(args.gop),
        "-g:v:1", str(args.gop),
        # No -keyint_min: pinning it equal to -g forbids the encoder from closing a
        # GOP early, which is exactly what force_key_frames asks it to do. At
        # 59.94fps a 120-frame GOP is 2.002s while force_key_frames wants 2.000s,
        # so the two never agree and segment durations come out uneven.
        "-force_key_frames:v:0", f"expr:gte(t,n_forced*{args.hls_time})",
        "-force_key_frames:v:1", f"expr:gte(t,n_forced*{args.hls_time})",
        "-profile:v:0", "high",
        "-profile:v:1", "high",
    ]

    if video_codec == "libx264":
        cmd += [
            "-level:v:0", "4.1",
            "-level:v:1", "4.1",
        ]

    cmd += [
        "-c:a", "aac",
        "-b:a", args.audio_bitrate,
        "-ac", "2",
        # async=1 corrects the audio start ONCE and then lets it free-run, so a
        # feed that drifts (reconnects, discarded packets) desyncs progressively
        # over a multi-hour card with nothing pulling it back. async=1000 allows
        # continuous correction of up to 1000 samples/sec.
        "-af", "aresample=async=1000:first_pts=0",
        "-max_muxing_queue_size", "9999",
        "-f", "dash",
        "-seg_duration", str(args.hls_time),
        "-frag_duration", str(args.hls_time),
        "-window_size", str(args.hls_size),
        "-extra_window_size", str(args.hls_delete_threshold),
        "-use_template", "1",
        "-use_timeline", "1",
        # A dynamic MPD locates the live edge as availabilityStartTime + media time,
        # compared against a clock. With no UTCTiming element the player has to use
        # the device's own clock, so every viewer's latency inherits their clock
        # skew and a fast clock requests segments before they exist. DASH-IF IOP
        # requires this for live. ffmpeg emits urn:mpeg:dash:utc:http-xsdate:2014,
        # so the URL must return an xs:dateTime body (nginx `location = /time`).
        *(["-utc_timing_url", args.utc_timing_url] if args.utc_timing_url else []),
        "-dash_segment_type", "mp4",
        "-hls_playlist", "1",
        "-hls_master_name", "ufc.m3u8",
        "-master_m3u8_publish_rate", "1",
        # Per-run prefix. Segment numbering restarts at 1 on every relaunch and the
        # init segments have fixed names, so without this a new run's files collide
        # with the previous run's and a player holding the old init decodes garbage.
        # Unique names also make each segment immutable for its whole lifetime,
        # which is the precondition for ever putting a CDN in front of them.
        "-init_seg_name", f"ufc_r{run_id}_init_$RepresentationID$.$ext$",
        "-media_seg_name", f"ufc_r{run_id}_chunk_$RepresentationID$_$Number%06d$.$ext$",
        "-adaptation_sets", "id=0,streams=0,1 id=1,streams=2",
        os.path.join(args.output_dir, "ufc.mpd"),
    ]

    return cmd


def interruptible_sleep(seconds, stop_flag):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if stop_flag():
            return
        time.sleep(0.1)


def fmt_duration(seconds):
    seconds = max(0, int(seconds))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h{m:02d}m{s:02d}s"
    return f"{m}m{s:02d}s"


def proc_stats(pid):
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as f:
            fields = f.read().split()
        total_ticks = int(fields[13]) + int(fields[14])
        ticks = os.sysconf("SC_CLK_TCK")
        cpu_s = total_ticks / ticks
        with open(f"/proc/{pid}/status", encoding="utf-8") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return cpu_s, int(line.split()[1]) / 1024
    except Exception:
        pass
    return None, None


def _write_encode_status(args, ff, link=None, lag_per_min=None):
    out_dir = getattr(args, "output_dir", None)
    if not out_dir:
        return
    try:
        payload = {
            "speed": ff.get("speed", ""),
            "fps": ff.get("fps", ""),
            "bitrate": ff.get("bitrate", ""),
            "out_time": ff.get("out_time", ""),
            "frame": ff.get("frame", ""),
            "at": time.time(),
        }
        # Which link is actually feeding this encode. The wrapper rotates links
        # internally, so without publishing it the app can only assume link 1 --
        # which is why a restart kept re-entering at link 1 and rediscovering the
        # working feed by burning through the failures ahead of it.
        if link:
            payload["link_url"] = link.get("url", "")
            payload["link_index"] = link.get("index", 0)
        if lag_per_min is not None:
            payload["read_lag_per_min"] = lag_per_min
        path = os.path.join(out_dir, ".encode-progress.json")
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(payload, handle)
        os.replace(tmp, path)
    except Exception:
        pass


PROGRESS_LOG_INTERVAL = 30.0


def update_progress(state, line, args=None, process_log=None, process_log_lock=None):
    line = line.strip()
    if "=" not in line:
        return
    key, value = line.split("=", 1)
    if not key:
        return
    snapshot = None
    active_link = None
    run_started_at = None
    should_log = False
    with with_lock(state):
        state["ffmpeg"][key] = value
        # ffmpeg -progress emits `progress=continue` to close each stats block;
        # snapshot the live values (incl. real speed) and publish for the app.
        if key == "progress":
            snapshot = dict(state["ffmpeg"])
            active_link = dict(state.get("active_link") or {})
            run_started_at = state.get("run_started_at")
            now_mono = time.monotonic()
            if now_mono - state.get("last_progress_log_at", 0.0) >= PROGRESS_LOG_INTERVAL:
                state["last_progress_log_at"] = now_mono
                should_log = True
    if snapshot is not None and args is not None:
        elapsed = (time.monotonic() - run_started_at) if run_started_at else 0.0
        _write_encode_status(args, snapshot, link=active_link,
                             lag_per_min=read_lag_per_minute(state, elapsed))
    if should_log and process_log is not None:
        # One line per interval, retaining exactly the fields needed to answer
        # "was the encoder keeping up, and was it dropping frames" after the fact.
        summary = " ".join(
            f"{field}={snapshot.get(field, '?')}"
            for field in ("out_time", "fps", "speed", "drop_frames", "dup_frames", "frame")
        )
        write_process_log(process_log, process_log_lock, "progress", summary)


def remember_ffmpeg_log(state, line, args):
    line = line.rstrip()
    if not line:
        return
    with with_lock(state):
        state["ffmpeg_logs"].append(line)
        state["last_ffmpeg_log_at"] = time.monotonic()
        if is_ffmpeg_error_line(line):
            state["ffmpeg_errors"].append(line)
    if args.verbose and not state.get("live_ui"):
        print(line, flush=True)


def is_ffmpeg_error_line(line):
    lowered = line.lower()
    noise = (
        "opening '",
        "frame i:",
        "frame p:",
        "frame b:",
        "weighted p-frames",
        "kb/s:",
        "qavg:",
        "consecutive b-frames",
        "mb i",
        "mb p",
        "mb b",
        "8x8 transform",
        "coded y,",
        "i16 v,",
        "i8 v,",
        "i4 v,",
        "i8c dc,",
    )
    if any(token in lowered for token in noise):
        return False
    return any(token in lowered for token in ("error", "failed", "invalid", "timed out", "timeout", "403", "404", "500", "connection"))


def stream_reader(stream, state, args, kind, process_log=None, process_log_lock=None):
    try:
        for line in iter(stream.readline, ""):
            if kind == "progress":
                # ffmpeg -progress emits ~12 key=value lines every second. Writing
                # them verbatim made the log ~99% noise (one run reached 11 MB) and
                # buried the stderr that actually matters — decode errors, timestamp
                # discontinuities, reconnects. Emit one condensed sample per
                # PROGRESS_LOG_INTERVAL instead, which doubles as the encode
                # time-series that .encode-progress.json (point-in-time) cannot give.
                update_progress(state, line, args, process_log, process_log_lock)
            else:
                write_process_log(process_log, process_log_lock, kind, line.rstrip())
                remember_ffmpeg_log(state, line, args)
                record_read_lag(state, line)
    except Exception as exc:
        add_event(state, f"ffmpeg {kind} reader stopped: {exc}", "warn")
    finally:
        with contextlib.suppress(Exception):
            stream.close()


#: ffmpeg's readrate pacer emits this whenever the upstream failed to deliver on
#: schedule. It is the single best discriminator of feed quality we have: measured
#: 2026-08-22, one soursignal feed ran at 0.4s of lag per minute while another ran
#: at 19.5s -- a ~50x difference in delivery smoothness that NOTHING in the health
#: scoring could see, because both kept ffmpeg at speed=1x with 0 dropped frames.
#: A bursty feed publishes segments in clumps, which starves player buffers and is
#: what viewers experience as the stream freezing for a second or two.
_READ_LAG_RE = re.compile(r"after a lag of ([\d.]+)s")


def record_read_lag(state, line):
    """Accumulate upstream read-lag seconds so feed quality can be scored."""
    match = _READ_LAG_RE.search(line)
    if not match:
        return
    try:
        seconds = float(match.group(1))
    except ValueError:
        return
    with with_lock(state):
        state["read_lag_seconds"] = state.get("read_lag_seconds", 0.0) + seconds
        state["read_lag_events"] = state.get("read_lag_events", 0) + 1


def read_lag_per_minute(state, elapsed_seconds):
    """Upstream lag seconds accumulated per minute of encoding. Lower is smoother."""
    if elapsed_seconds < 30:
        return None
    with with_lock(state):
        total = float(state.get("read_lag_seconds", 0.0))
    return round(total / (elapsed_seconds / 60.0), 2)


def ffmpeg_snapshot(state):
    with with_lock(state):
        progress = dict(state["ffmpeg"])
        logs = list(state["ffmpeg_logs"])
        events = list(state["events"])
    return progress, logs, events


def ffmpeg_error_summary(state, limit=3):
    with with_lock(state):
        errors = list(state["ffmpeg_errors"])[-limit:]
        logs = list(state["ffmpeg_logs"])[-limit:]
    chosen = errors or logs
    if not chosen:
        return ""
    return " | ".join(fit(line, 180) for line in chosen)


def render_live_panel(state, args, health, encoder, frame):
    width = panel_width()
    now = time.monotonic()
    progress, logs, events = ffmpeg_snapshot(state)
    current = health[state["url_index"]]
    pid = state["proc_pid"]
    cpu_s, rss_mb = proc_stats(pid) if pid else (None, None)

    seg_files = glob.glob(os.path.join(args.output_dir, "ufc*.ts"))
    seg_bytes = sum(os.path.getsize(f) for f in seg_files if os.path.exists(f))
    m3u8 = os.path.join(args.output_dir, "ufc.m3u8")
    age = "waiting"
    if os.path.exists(m3u8):
        age = f"{time.time() - os.path.getmtime(m3u8):.1f}s ago"

    body_width = width
    rule = ansi("─" * max(0, body_width - 10), "38;5;240", args)
    spin = ansi(SPINNER[frame % len(SPINNER)], "38;5;45;1", args)
    title = fit(f"{spin} {ansi(APP_NAME, '38;5;45;1', args)} {ansi('stream commander', '38;5;111;1', args)} {rule}", body_width)

    stream_elapsed = fmt_duration(now - state["stream_start"]) if state["stream_start"] else "waiting"
    best = max(health, key=lambda h: h.best_runtime)
    speed = progress.get("speed", "n/a")
    fps = progress.get("fps", "n/a")
    bitrate = progress.get("bitrate", "n/a")
    frame_no = progress.get("frame", "n/a")
    out_time = progress.get("out_time", progress.get("out_time_ms", "n/a"))

    ratio = 0.0
    if current.attempts:
        ratio = min(1.0, current.assessment_runtime / max(args.min_assessment_seconds, 1.0))

    lines = [
        title,
        render_kv("encoder", f"{encoder.title} ({encoder.codec})", body_width, args),
        render_kv("link", f"[{current.index + 1}/{len(health)}] {short_url(current.url, max(18, body_width - 24))}", body_width, args),
        render_kv("runtime", f"tool {fmt_duration(now - state['tool_start'])} | stream {stream_elapsed} | restarts {state['restarts']}", body_width, args),
        render_kv("hls", f"{len(seg_files)} segments | {seg_bytes / (1024 * 1024):.1f} MB | playlist {age}", body_width, args),
        render_kv("ffmpeg", f"frame {frame_no} | fps {fps} | bitrate {bitrate} | speed {speed} | out {out_time}", body_width, args),
        render_kv("process", f"pid {pid or 'waiting'} | cpu {f'{cpu_s:.1f}s' if cpu_s is not None else 'n/a'} | rss {f'{rss_mb:.0f} MB' if rss_mb is not None else 'n/a'}", body_width, args),
        render_kv(
            "score",
            f"{current.last_score:.1f} {current.last_decision} | evidence {current.assessment_runtime:.1f}/{args.min_assessment_seconds:.1f}s",
            body_width,
            args,
        ),
        render_kv("best", f"link {best.index + 1} | best run {fmt_duration(best.best_runtime)} | average {fmt_duration(best.average_runtime)}", body_width, args),
        "  " + progress_bar(ratio, max(10, body_width - 4), args),
    ]

    if events:
        lines.append(ansi("  events", "38;5;111;1", args))
        for _, level, text in events[-4:]:
            marker = {"info": "·", "ok": "+", "warn": "!", "bad": "x"}.get(level, "·")
            colored_marker = {"info": label(marker, args), "ok": ok(marker, args), "warn": warn(marker, args), "bad": bad(marker, args)}.get(level, label(marker, args))
            lines.append(f"  {colored_marker} {fit(text, body_width - 4)}")

    if logs:
        lines.append(ansi("  ffmpeg", "38;5;111;1", args))
        for line in logs[-4:]:
            color = "38;5;203" if is_ffmpeg_error_line(line) else "38;5;250"
            lines.append("  " + ansi(fit(line, body_width - 4), color, args))

    footer = fit("  keys: n/right-arrow next link | q quit | Ctrl-C stop", body_width)
    lines.append(ansi(footer, "38;5;245", args))
    max_rows = max(8, term_height() - 1)
    if len(lines) > max_rows:
        lines = lines[: max_rows - 1] + [ansi("  …", "38;5;245", args)]
    else:
        lines.extend([""] * (max_rows - len(lines)))
    return "\n".join(lines)


def status_thread(state, args, health, encoder, interval=10):
    def run():
        if state.get("live_ui"):
            frame = 0
            try:
                print("\033[?25l\033[2J\033[3J\033[H", end="", flush=True)
                while not state["interrupted"]:
                    print("\033[H\033[J" + render_live_panel(state, args, health, encoder, frame), end="", flush=True)
                    frame += 1
                    interruptible_sleep(0.16, lambda: state["interrupted"])
            finally:
                print("\033[?25h\033[0m", end="", flush=True)
            return

        while not state["interrupted"]:
            interruptible_sleep(interval, lambda: state["interrupted"])
            if state["interrupted"]:
                break
            now = time.monotonic()
            current = health[state["url_index"]]
            progress, logs, _ = ffmpeg_snapshot(state)
            msg = (
                f"status: link {current.index + 1}/{len(health)}, "
                f"stream {fmt_duration(now - state['stream_start']) if state['stream_start'] else 'waiting'}, "
                f"score {current.last_score:.1f} {current.last_decision}, "
                f"speed {progress.get('speed', 'n/a')}, fps {progress.get('fps', 'n/a')}, "
                f"last ffmpeg: {logs[-1] if logs else 'none'}"
            )
            print(f"{icon(APP_NAME, args)} {fit(msg, term_width())}", flush=True)

    t = threading.Thread(target=run, daemon=True)
    t.start()
    return t


def next_stream_index(health, current_index):
    if len(health) <= 1:
        return current_index, False
    now = time.monotonic()
    available = [h for h in health if h.backoff_until <= now]
    if not available:
        return min(health, key=lambda h: h.backoff_until).index, True
    if all(h.tried_this_round for h in health):
        all_failed = all(h.failed_this_round for h in health)
        for h in health:
            h.tried_this_round = False
            h.failed_this_round = False
        if all_failed:
            available = [h for h in health if h.backoff_until <= now]
            if available:
                return max(available, key=lambda h: h.score(now, current_index, explore_bias=0.0)).index, True
            return min(health, key=lambda h: h.backoff_until).index, True
        return max(available, key=lambda h: h.score(now, current_index, explore_bias=0.0)).index, False
    candidates = [h for h in health if not h.tried_this_round and h.backoff_until <= now]
    if not candidates:
        candidates = available
    return max(candidates, key=lambda h: h.score(now, current_index)).index, False


def manual_next_index(health, current_index):
    if len(health) <= 1:
        return current_index
    return (current_index + 1) % len(health)


def parse_out_time(value):
    """ffmpeg's HH:MM:SS.mmm progress field as seconds, or None."""
    try:
        hours, minutes, seconds = str(value).split(":")
        return int(hours) * 3600 + int(minutes) * 60 + float(seconds)
    except (ValueError, AttributeError):
        return None


def next_available_index(health, current_index):
    """Next link that is not in backoff, wrapping; falls back to plain rotation."""
    if len(health) <= 1:
        return current_index
    now = time.monotonic()
    for step in range(1, len(health) + 1):
        candidate = (current_index + step) % len(health)
        if health[candidate].backoff_until <= now:
            return candidate
    return manual_next_index(health, current_index)


def realtime_watchdog_thread(state, args, health):
    """Rotate off an upstream that is delivering slower than realtime.

    Nothing else catches this. The health scoring asks whether ffmpeg is emitting
    frames and whether the playlist is fresh — both stay true while a feed decays
    to 0.7x, so it scores healthy while the stream slides further behind live
    every second (observed: 92s behind and growing, score still 380).

    Two things make this measurable and safe. `speed=` is a CUMULATIVE average
    and lags reality badly, so the rate is derived from out_time deltas over wall
    clock instead. And a rotation no longer wipes the output directory, so the
    cost of being wrong is a brief gap rather than 404ing every viewer.
    """
    if args.min_encode_rate <= 0 or len(health) <= 1:
        return None

    def run():
        base_at = None       # wall clock of the first settled sample
        base_out = None      # content produced at that moment
        last_at = None
        last_out = None
        last_rotation_at = 0.0
        rotations = 0
        while not state["interrupted"]:
            interruptible_sleep(5.0, lambda: state["interrupted"])
            if state["interrupted"]:
                break
            progress, _, _ = ffmpeg_snapshot(state)
            out_seconds = parse_out_time(progress.get("out_time"))
            now = time.monotonic()
            started = state.get("stream_start")

            # A relaunch restarts out_time at zero; never diff across that.
            if out_seconds is None or (last_out is not None and out_seconds < last_out):
                base_at = base_out = last_at = last_out = None
                continue
            # Judge only a settled run: the initial burst reads far above 1x.
            if not started or (now - started) < max(args.min_assessment_seconds, 30.0):
                continue
            if base_at is None:
                base_at, base_out = now, out_seconds
                last_at, last_out = now, out_seconds
                continue

            wall = now - last_at
            if wall < 4.0:
                continue
            rate = (out_seconds - last_out) / wall
            last_at, last_out = now, out_seconds

            # Accumulated shortfall, NOT a run of low samples. An upstream dip of
            # a minute or two is normal and --readrate_catchup drains it back to
            # zero on its own (observed: 37s of deficit fully recovered). Rotating
            # on "rate was low for N seconds" fires on exactly those recoverable
            # dips. What actually distinguishes a dying feed is a deficit that
            # keeps growing because nothing is draining it.
            deficit = (now - base_at) - (out_seconds - base_out)
            if deficit < args.max_drift_seconds:
                continue
            # Still behind, but catching up: leave it alone, that is the fix working.
            if rate >= 1.0:
                continue
            if now - last_rotation_at < args.slow_source_cooldown:
                continue
            if rotations >= args.max_auto_rotations:
                continue

            current = health[state["url_index"]]
            target = next_available_index(health, state["url_index"])
            if target == state["url_index"]:
                # Every alternative is in backoff; rotating in place would just
                # restart onto the same slow feed.
                continue

            # Hold the slow link down so rotation cannot land straight back on it.
            current.backoff_until = now + args.slow_source_backoff
            rotations += 1
            last_rotation_at = now
            state["url_index"] = target
            # Reuses the manual-switch path deliberately: the link is slow, not
            # failed, so it must not be scored as a failure and pushed toward the
            # stop-after-failed-rounds kill switch.
            state["manual_rotate"] = True
            emit(
                state,
                args,
                f"upstream not keeping up ({rate:.2f}x, {int(deficit)}s behind and not recovering) "
                f"-> auto-switch to link [{target + 1}/{len(health)}] {short_url(health[target].url)}",
                "warn",
            )
            proc = state.get("proc_obj")
            if proc and proc.poll() is None:
                proc.terminate()
            last_at, last_out = None, None

    thread = threading.Thread(target=run, daemon=True)
    thread.start()
    return thread


def keyboard_thread(state, health, args):
    if not sys.stdin.isatty():
        return None

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)

    def stop_proc():
        p = state.get("proc_obj")
        if p and p.poll() is None:
            p.terminate()

    def run():
        try:
            tty.setraw(fd)
            while not state["interrupted"]:
                r, _, _ = select.select([sys.stdin], [], [], 0.2)
                if not r:
                    continue
                ch = sys.stdin.read(1)

                if ch == "\x03" or ch == "q":
                    emit(state, args, "quit requested", "bad")
                    state["interrupted"] = True
                    stop_proc()
                    break

                if ch == "n" or ch == "\x1b":
                    if ch == "\x1b":
                        r2, _, _ = select.select([sys.stdin], [], [], 0.05)
                        if not r2:
                            continue
                        if sys.stdin.read(2) != "[C":
                            continue

                    next_idx = manual_next_index(health, state["url_index"])
                    state["url_index"] = next_idx
                    state["manual_rotate"] = True
                    emit(state, args, f"manual switch -> [{next_idx + 1}/{len(health)}] {short_url(health[next_idx].url)}")
                    stop_proc()
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

    t = threading.Thread(target=run, daemon=True)
    t.start()
    return t


def parser_for_args():
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="Obbystreams transcoder - resilient DASH/HLS output with smart GPU and URL fallback.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )

    parser.add_argument("url", nargs="*", help="Stream URL(s) (positional)")
    parser.add_argument("--link", "-l", dest="link", metavar="URL", action="append",
                        help="Stream URL; repeat like --link URL1 --link URL2")
    parser.add_argument("--links", dest="links", metavar="URL", nargs="+",
                        help="One or more stream URLs after a single --links flag")
    parser.add_argument("--source-config", dest="source_config", default="",
                        help="JSON source manifest with per-source request headers")

    enc = parser.add_mutually_exclusive_group()
    enc.add_argument("--encoder", default="auto",
                     choices=["auto", "gpu", "gpu-only", "gpu-trans", "nv", "nvidia", "nvenc", "nv-gpu-trans",
                              "intel", "qsv", "intel-gpu-trans", "amd", "amf", "amd-gpu-trans", "vaapi", "cpu"],
                     help="Transcode backend. auto tries GPU first and falls back to CPU.")
    enc.add_argument("--gpu", dest="encoder", action="store_const", const="gpu-trans",
                     help="Alias for --encoder gpu-trans")
    enc.add_argument("--gpu-trans", dest="encoder", action="store_const", const="gpu-trans",
                     help="Auto-select the best available GPU transcoder")
    enc.add_argument("--nv-gpu-trans", dest="encoder", action="store_const", const="nv-gpu-trans",
                     help="Require NVIDIA NVENC, then fall back to CPU if unavailable")
    enc.add_argument("--intel-gpu-trans", dest="encoder", action="store_const", const="intel-gpu-trans",
                     help="Require Intel Quick Sync, then fall back to CPU if unavailable")
    enc.add_argument("--amd-gpu-trans", dest="encoder", action="store_const", const="amd-gpu-trans",
                     help="Require AMD AMF, then fall back to CPU if unavailable")
    enc.add_argument("--vaapi", dest="encoder", action="store_const", const="vaapi",
                     help="Require VAAPI, then fall back to CPU if unavailable")
    enc.add_argument("--cpu", dest="encoder", action="store_const", const="cpu",
                     help="Use CPU libx264 encoding")

    parser.add_argument("--preset", default="veryfast",
                        choices=["ultrafast", "superfast", "veryfast", "faster", "fast", "medium"],
                        help="x264 preset (CPU only)")
    parser.add_argument("--bitrate", "-b", default="8M", dest="video_bitrate", help="Video bitrate")
    parser.add_argument("--maxrate", default="12M", help="Max video bitrate")
    parser.add_argument("--bufsize", default="24M", help="Video buffer size")
    parser.add_argument("--bitrate-720", default="3500k", dest="video_bitrate_720", help="720p rendition video bitrate")
    parser.add_argument("--maxrate-720", default="4500k", dest="maxrate_720", help="720p rendition max video bitrate")
    parser.add_argument("--bufsize-720", default="9000k", dest="bufsize_720", help="720p rendition video buffer size")
    parser.add_argument("--bitrate-1080", default=None, dest="video_bitrate_1080", help="1080p rendition video bitrate")
    parser.add_argument("--maxrate-1080", default=None, dest="maxrate_1080", help="1080p rendition max video bitrate")
    parser.add_argument("--bufsize-1080", default=None, dest="bufsize_1080", help="1080p rendition video buffer size")
    parser.add_argument("--audio-bitrate", "-ab", default="192k", dest="audio_bitrate", help="Audio bitrate")
    # 2s segments keep the player's 3-segment live buffer down to ~6s. The GOP below is
    # 120 frames (~2s at 59.94fps), so segments still start on a keyframe.
    parser.add_argument("--hls-time", default=2, type=int, help="HLS segment duration in seconds")
    parser.add_argument("--hls-size", default=15, type=int, help="HLS playlist size in segments")
    # Retention beyond the published window. A viewer on a weak connection drifts
    # behind the live edge; if the segment it is still fetching has already been
    # deleted it 404s, the player errors, and the recovery is a visible skip.
    # 15 + 20 = 70s of files on disk (~105 MB) against a 30s published window.
    parser.add_argument("--hls-delete-threshold", default=20, type=int, help="Extra old HLS segments to keep")
    parser.add_argument("--gop", default=120, type=int, help="GOP / keyframe interval")
    parser.add_argument("--output-dir", default=DEFAULT_STREAM_DIR, dest="output_dir", help="HLS output directory")
    parser.add_argument("--ffmpeg-log-dir", default=DEFAULT_FFMPEG_LOG_DIR, dest="ffmpeg_log_dir",
                        help="Directory for one persistent log file per ffmpeg process")
    parser.add_argument("--no-restart", action="store_true", help="Disable auto-restart on ffmpeg exit")
    parser.add_argument("--restart-delay", default=2.0, type=float, help="Seconds between auto-restarts")
    parser.add_argument("--max-restart-delay", default=120.0, type=float, help="Maximum exponential retry backoff in seconds")
    parser.add_argument("--backoff-multiplier", default=2.0, type=float, help="Retry backoff multiplier after consecutive failures")
    parser.add_argument("--backoff-jitter", default=0.25, type=float, help="Retry backoff jitter ratio")
    parser.add_argument("--rate-limit-delay", default=180.0, type=float,
                        help="Minimum cooldown when ffmpeg reports HTTP 429 / rate limiting")
    parser.add_argument("--no-reconnect", action="store_true", help="Disable ffmpeg-level reconnect flags")
    parser.add_argument("--reconnect-delay", default=5, type=int, dest="reconnect_delay", help="Max ffmpeg reconnect delay")
    parser.add_argument("--timeout", default=10, type=int, help="HTTP read/connect timeout in seconds")
    parser.add_argument("--utc-timing-url", dest="utc_timing_url",
                        default="https://fight.nswfiles.com/time",
                        help="URL returning an xs:dateTime body, published as the MPD's "
                             "UTCTiming element so players do not rely on the device clock")
    parser.add_argument("--min-encode-rate", default=0.92, type=float, dest="min_encode_rate",
                        help="Set to 0 to disable slow-upstream auto-rotation entirely. Health "
                             "scoring cannot see this failure: a decaying feed keeps emitting "
                             "frames and a fresh playlist, and scores healthy the whole way down")
    parser.add_argument("--max-drift-seconds", default=60.0, type=float, dest="max_drift_seconds",
                        help="Rotate once the stream has fallen this far behind realtime AND is "
                             "not catching up. Deliberately measured as accumulated drift rather "
                             "than a run of slow samples, so a recoverable dip that --readrate-catchup "
                             "drains does not cost viewers a switch")
    parser.add_argument("--slow-source-cooldown", default=300.0, type=float, dest="slow_source_cooldown",
                        help="Minimum gap between automatic slow-source rotations")
    parser.add_argument("--slow-source-backoff", default=900.0, type=float, dest="slow_source_backoff",
                        help="How long a link rotated away from for being slow is skipped")
    parser.add_argument("--max-auto-rotations", default=3, type=int, dest="max_auto_rotations",
                        help="Cap on automatic slow-source rotations per supervisor run, so a "
                             "provider that is slow on every link cannot cause endless restarts")
    parser.add_argument("--readrate", default=1.0, type=float,
                        help="Pace input reads at this multiple of realtime (0 disables pacing). "
                             "1.0 keeps the media clock aligned with wall clock")
    parser.add_argument("--readrate-initial-burst", default=4.0, type=float, dest="readrate_initial_burst",
                        help="Seconds of input to burst-read before pacing applies, to fill the "
                             "pipeline at startup without skewing the media clock for the whole run")
    parser.add_argument("--readrate-catchup", default=2.0, type=float, dest="readrate_catchup",
                        help="Temporary read rate used to drain lag after an input stall. ffmpeg's "
                             "default of 1.05 is too slow to recover, so lag compounds")
    parser.add_argument("--thread-queue-size", default=8192, type=int, dest="thread_queue_size", help="ffmpeg input queue size")
    parser.add_argument("--analyzeduration", default=2_000_000, type=int, help="ffmpeg analyze duration in microseconds")
    parser.add_argument("--probesize", default=2_000_000, type=int, help="ffmpeg probe size in bytes")
    parser.add_argument("--quick-fail", default=30.0, type=float, dest="quick_fail",
                        help="A stream run shorter than this is treated as weak")
    parser.add_argument("--min-assessment-seconds", default=15.0, type=float,
                        help="Minimum cumulative runtime before a stream can be confirmed failed")
    parser.add_argument("--success-score-threshold", default=180.0, type=float,
                        help="Positive evidence score required to mark a stream healthy")
    parser.add_argument("--failure-score-threshold", default=-120.0, type=float,
                        help="Negative evidence score required before failure samples count")
    parser.add_argument("--confirmed-failure-samples", default=2, type=int,
                        help="Bad scoring samples required before rotating or stopping")
    parser.add_argument("--failure-ramp-seconds", default=60.0, type=float,
                        help="Seconds over which negative scoring ramps to full weight")
    parser.add_argument("--stop-after-failed-rounds", default=2, type=int,
                        help="Stop after every link confirms failure this many full rounds in a row")
    parser.add_argument("--clean-exit-retries", default=2, type=int,
                        help="Retry the same link this many times after ffmpeg exits 0 (a live "
                             "upstream closing the connection) before rotating to the next link")
    parser.add_argument("--verbose", "-v", action="store_true", help="Show ffmpeg output")
    parser.add_argument("--print-cmd", action="store_true", help="Print the ffmpeg command and exit")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI color")
    return parser


def is_capacity_limited_error(error_summary):
    lowered = (error_summary or "").lower()
    return any(
        token in lowered
        for token in (
            "429",
            "too many requests",
            "too many streams",
            "too many connections",
            "concurrent stream",
            "concurrent connection",
            "rate limit",
        )
    )


def retry_backoff_delay(stream, args, error_summary, return_code, confirmed_failure=False):
    if return_code == 0:
        stream.backoff_until = 0.0
        return args.restart_delay

    if is_capacity_limited_error(error_summary):
        base = max(args.rate_limit_delay, args.restart_delay)
    elif not confirmed_failure:
        base = args.restart_delay
    else:
        exponent = max(0, stream.confirmed_failures - 1)
        base = args.restart_delay * (args.backoff_multiplier ** exponent)
    delay = min(args.max_restart_delay, base)
    jitter_ratio = max(0.0, args.backoff_jitter)
    if jitter_ratio:
        delay += random.uniform(0, delay * jitter_ratio)
    stream.backoff_until = time.monotonic() + delay
    return delay


def main():
    os.umask(0o002)
    parser = parser_for_args()
    args = parser.parse_args()
    args.video_bitrate_1080 = args.video_bitrate_1080 or args.video_bitrate
    args.maxrate_1080 = args.maxrate_1080 or args.maxrate
    args.bufsize_1080 = args.bufsize_1080 or args.bufsize
    args.reconnect = not args.no_reconnect
    args.min_assessment_seconds = max(15.0, float(args.min_assessment_seconds))
    args.confirmed_failure_samples = max(1, int(args.confirmed_failure_samples))
    args.failure_ramp_seconds = max(15.0, float(args.failure_ramp_seconds))
    args.source_headers = load_source_headers(args.source_config)

    urls = list(args.url or []) + list(args.link or []) + list(args.links or [])
    if not urls:
        parser.error(f"At least one URL required: {APP_NAME} <URL>, {APP_NAME} --link <URL>, or {APP_NAME} --links <URL> <URL>")

    encoder, profiles = choose_encoder(args)

    if args.print_cmd:
        print(" \\\n+  ".join(build_ffmpeg_cmd(args, urls[0], encoder)).replace("\\\n+  ", "\\\n  "))
        return

    ensure_output_dir(args.output_dir)
    args.ffmpeg_log_dir = ensure_ffmpeg_log_dir(args.ffmpeg_log_dir)

    running = find_running_instances()
    if running:
        print(f"\n{warn(APP_NAME, args)} {len(running)} streaming instance(s) already running:")
        for pid, cmd in running:
            print(f"  {label(str(pid), args)} {cmd[:96]}")
        try:
            answer = input("\nKill existing instance(s) and start a new one? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nAborted.")
            sys.exit(1)
        if answer in ("y", "yes"):
            kill_instances(running)
            print(ok("Killed.\n", args))
        else:
            print("Existing instance left running. Exiting.")
            sys.exit(0)

    # NOT a full wipe. A supervisor restart is the normal way this process starts
    # (source refresh, watchdog), and the previous supervisor's segments are still
    # being fetched by live viewers at that moment. Age-gated pruning lets the
    # handover happen without 404ing everyone, and the outgoing files disappear
    # on their own once nobody can still be asking for them.
    prune_foreign_runs(args.output_dir, set())

    health = [StreamHealth(i, u) for i, u in enumerate(urls)]
    state = {
        "interrupted": False,
        "tool_start": time.monotonic(),
        "stream_start": None,
        "proc_pid": None,
        "proc_obj": None,
        "url_index": 0,
        "restarts": 0,
        "failed_rounds": 0,
        "manual_rotate": False,
        "lock": threading.Lock(),
        "events": deque(maxlen=8),
        "ffmpeg": {},
        "ffmpeg_logs": deque(maxlen=8),
        "ffmpeg_errors": deque(maxlen=24),
        "last_ffmpeg_log_at": None,
        "last_progress_log_at": 0.0,
        "live_ui": sys.stdout.isatty() and not args.verbose,
    }
    proc = None

    def stop(sig=None, frame=None):
        state["interrupted"] = True
        if proc and proc.poll() is None:
            proc.terminate()

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    if not state["live_ui"]:
        available = ", ".join(p.key for p in sorted(profiles, key=lambda p: p.score, reverse=True) if p.key != "cpu") or "none"
        print(icon(APP_NAME, args) + " " + ansi("stream commander", "38;5;111;1", args))
        print(render_kv("encoder", f"{encoder.title} ({encoder.codec})", term_width(), args))
        if encoder.key == "cpu" and available == "none":
            print(render_kv("gpu", warn("none accessible; CPU selected without sudo", args), term_width(), args))
        else:
            print(render_kv("gpu", f"available: {available}", term_width(), args))
        print(render_kv("output", os.path.join(args.output_dir, "ufc.m3u8"), term_width(), args))
        print(render_kv("ffmpeg logs", args.ffmpeg_log_dir, term_width(), args))
        print(render_kv("fallback", f"smart health scoring across {len(urls)} link(s)", term_width(), args))
        print(render_kv("assessment", f"{args.min_assessment_seconds:.0f}s min, {args.confirmed_failure_samples} bad samples to fail", term_width(), args))
        print(render_kv("reconnect", "off" if not args.reconnect else f"on, max {args.reconnect_delay}s", term_width(), args))
        print(render_kv("backoff", f"{args.restart_delay:.1f}s base, {args.max_restart_delay:.0f}s max, {args.rate_limit_delay:.0f}s on 429", term_width(), args))
        print(render_kv("keys", "n/right-arrow next link, q quit", term_width(), args))
        for h in health:
            print(render_kv(f"link {h.index + 1}", short_url(h.url, max(20, term_width() - 20)), term_width(), args))
        print()

    status_thread(state, args, health, encoder, interval=10)
    realtime_watchdog_thread(state, args, health)
    keyboard_thread(state, health, args)

    previous_run = None
    try:
        while not state["interrupted"]:
            current = health[state["url_index"]]
            current.record_start()
            this_run = run_token()
            # run_token() is second-resolution; a fast relaunch inside the same
            # second would otherwise reuse the previous run's namespace.
            while this_run == previous_run:
                time.sleep(0.4)
                this_run = run_token()
            cmd = build_ffmpeg_cmd(args, current.url, encoder, run_id=this_run)
            with with_lock(state):
                state["active_link"] = {"url": current.url, "index": state["url_index"]}
                # Per-run, so a feed is scored on the run being measured rather
                # than inheriting a previous link's behaviour.
                state["read_lag_seconds"] = 0.0
                state["read_lag_events"] = 0
                state["run_started_at"] = time.monotonic()

            # Keep the outgoing run's segments so players mid-fetch still resolve
            # while the new run comes up; drop everything older than that.
            prune_foreign_runs(args.output_dir, {this_run, previous_run} - {None})
            previous_run = this_run
            action = "restart" if state["restarts"] else "starting"
            with with_lock(state):
                state["ffmpeg"] = {}
                state["ffmpeg_logs"].clear()
                state["ffmpeg_errors"].clear()
                state["last_ffmpeg_log_at"] = None
                # Log the first progress sample of a new run immediately rather
                # than waiting out the interval from the previous one.
                state["last_progress_log_at"] = 0.0
            emit(state, args, f"{action} -> link [{current.index + 1}/{len(health)}] {short_url(current.url)}")

            stream_start = time.monotonic()
            state["stream_start"] = stream_start
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
            state["proc_obj"] = proc
            state["proc_pid"] = proc.pid
            log_path, process_log, process_log_lock = open_ffmpeg_process_log(args, current, cmd, encoder, proc)
            emit(state, args, f"ffmpeg log -> {log_path}", "info")
            stdout_thread = threading.Thread(target=stream_reader, args=(proc.stdout, state, args, "progress", process_log, process_log_lock), daemon=True)
            stderr_thread = threading.Thread(target=stream_reader, args=(proc.stderr, state, args, "stderr", process_log, process_log_lock), daemon=True)
            stdout_thread.start()
            stderr_thread.start()
            proc.wait()
            stdout_thread.join(timeout=2)
            stderr_thread.join(timeout=2)
            state["proc_pid"] = None

            if state["interrupted"]:
                write_process_log(process_log, process_log_lock, "exit", "interrupted")
                process_log.close()
                break

            elapsed = time.monotonic() - stream_start
            rc = proc.returncode
            msg = f"ffmpeg exited code {rc}, ran {fmt_duration(elapsed)}"
            error_summary = ffmpeg_error_summary(state)
            if error_summary:
                current.last_error = error_summary
                msg += f" | ffmpeg: {error_summary}"
            progress, _, _ = ffmpeg_snapshot(state)
            hls = hls_probe(args.output_dir, run_id=this_run)
            if state["manual_rotate"]:
                assessment = {"decision": "manual", "score": current.last_score, "reasons": []}
            else:
                assessment = current.record_exit(elapsed, args, failed=(rc != 0), error_summary=error_summary, progress=progress, hls=hls)
                reasons = assessment.get("reasons") or []
                assessment_runtime = assessment.get("evidence", {}).get("assessment_runtime", current.assessment_runtime)
                msg += (
                    f" | score {assessment['score']:.1f}, "
                    f"{assessment['decision']}, assessment {assessment_runtime:.1f}/{args.min_assessment_seconds:.1f}s"
                )
                if reasons:
                    msg += f" ({'; '.join(reasons[:2])})"
            write_process_log(
                process_log,
                process_log_lock,
                "summary",
                json.dumps(
                    {
                        "return_code": rc,
                        "elapsed_seconds": round(elapsed, 3),
                        "error_summary": error_summary,
                        "progress": progress,
                        "hls": hls,
                        "assessment": assessment,
                    },
                    ensure_ascii=True,
                    sort_keys=True,
                ),
            )
            process_log.close()

            if args.no_restart:
                emit(state, args, msg + " - no-restart set, exiting.", "warn" if rc else "ok")
                break

            state["restarts"] += 1
            all_failed = False
            # A link that streamed for minutes has proven itself; a later upstream
            # close earns a fresh retry budget rather than inheriting the count
            # from some earlier bad patch.
            if elapsed >= CLEAN_EXIT_RESET_SECONDS:
                current.clean_exits = 0
            confirmed_failure = assessment["decision"] == "failed"
            still_assessing = assessment["decision"] == "assessing"
            capacity_limited = is_capacity_limited_error(error_summary)

            if state["manual_rotate"]:
                state["manual_rotate"] = False
                msg += " - manual switch requested"
            elif still_assessing:
                msg += f" - retrying same link until at least {args.min_assessment_seconds:.0f}s of evidence"
            elif capacity_limited:
                msg += " - upstream capacity limit; cooling down current link without rotating"
            elif confirmed_failure and len(health) > 1:
                previous = state["url_index"]
                state["url_index"], all_failed = next_stream_index(health, previous)
                if all_failed:
                    state["url_index"] = 0
                    msg += " - every link has confirmed failure this round; returning to link 1"
                else:
                    msg += f" - confirmed weak stream, switching to link {state['url_index'] + 1}"
                current.reset_assessment_window()
            elif confirmed_failure and len(health) == 1:
                all_failed = True
                msg += " - only link has confirmed failure"
                current.reset_assessment_window()
            elif rc != 0:
                msg += " - evidence is not bad enough to rotate; retrying same link"
            elif current.clean_exits < args.clean_exit_retries:
                # rc == 0 means ffmpeg considered the input finished, which for a
                # live feed usually means the upstream dropped the connection --
                # not that this link is bad. Rotating on the first clean exit cost
                # three viewer-visible restarts in 78s on 2026-08-22, on runs the
                # scorer itself rated healthy (~708) that each ran ~20s before the
                # provider EOF'd. Give the link its retries back before moving.
                current.clean_exits += 1
                msg += (
                    f" - upstream closed cleanly; retrying same link"
                    f" ({current.clean_exits}/{args.clean_exit_retries})"
                )
            elif len(health) > 1:
                # Long-lived streams earn priority, but still rotate after death so alternatives get sampled.
                current.clean_exits = 0
                state["url_index"], all_failed = next_stream_index(health, state["url_index"])
                if all_failed:
                    state["url_index"] = 0
                    msg += " - every link has confirmed failure this round; returning to link 1"
                else:
                    msg += f" - stream ended, trying link {state['url_index'] + 1}"

            current_backoff_delay = retry_backoff_delay(current, args, error_summary, rc, confirmed_failure=confirmed_failure)
            if confirmed_failure and all_failed:
                state["failed_rounds"] += 1
            elif not confirmed_failure:
                state["failed_rounds"] = 0
            if args.stop_after_failed_rounds > 0 and state["failed_rounds"] >= args.stop_after_failed_rounds:
                emit(
                    state,
                    args,
                    f"{msg} - all links confirmed failed {state['failed_rounds']} rounds in a row; stopping to avoid rate limits.",
                    "bad",
                )
                break
            selected = health[state["url_index"]]
            selected_backoff = max(0.0, selected.backoff_until - time.monotonic())
            retry_delay = current_backoff_delay if selected.index == current.index else max(args.restart_delay, selected_backoff)
            emit(state, args, f"{msg} - retrying in {retry_delay:.1f}s", "warn" if rc else "ok")
            interruptible_sleep(retry_delay, lambda: state["interrupted"])

    finally:
        state["interrupted"] = True
        if proc and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
        # Leave the published segments and manifests in place. A stop is almost
        # always immediately followed by a replacement supervisor, and wiping here
        # is what actually pulled the DVR window out from under viewers on every
        # restart. Anything genuinely stale is pruned by age on the next start.
        prune_foreign_runs(args.output_dir, set())
        print(f"\n{icon(APP_NAME, args)} stopped.")


if __name__ == "__main__":
    main()
